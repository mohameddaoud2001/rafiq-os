{"id": "dhikr_1", "text": "سبحان الله والحمد لله - ذكر السفر", "work": "الأذكار", "tags": ["سفر", "عام"], "verified": false, "tariqa_specific": false}
{"id": "dhikr_2", "text": "اللهم إنا نسألك في سفرنا هذا البر والتقوى", "work": "الأذكار", "tags": ["سفر"], "verified": false, "tariqa_specific": false}
{"id": "dhikr_3", "text": "لا إله إلا الله وحده لا شريك له - يوم عرفة", "work": "الأذكار", "tags": ["عرفة"], "verified": false, "tariqa_specific": false}
{"id": "dhikr_4", "text": "الله أكبر، الله أكبر، لا إله إلا الله", "work": "الأذكار", "tags": ["عرفة", "تكبير"], "verified": false, "tariqa_specific": false}
{"id": "dhikr_5", "text": "أستغفر الله العظيم", "work": "الأذكار", "tags": ["عام"], "verified": false, "tariqa_specific": false}
{"id": "dhikr_6", "text": "ورد شاذلي خاص - يحتاج إجازة", "work": "أوراد", "tags": ["شاذلي"], "verified": false, "tariqa_specific": true, "tariqa": "shadhiliyya", "ijaza_approved": false}
